{
  "name": "helfy-create",
  "version": "0.8.0",
  "description": "Create a new Helfy project",
  "bin": {
    "helfy-create": "./bin/create-helfy.js"
  },
  "files": [
    "bin",
    "template/.prettierignore",
    "template/eslint.config.mjs",
    "template/prettier.config.cjs",
    "template/gitignore",
    "template/package.json",
    "template/package-lock.json",
    "template/tsconfig.json",
    "template/rspack.config.js",
    "template/declaration.d.ts",
    "template/ARCHITECTURE.md",
    "template/src",
    "template/README.md",
    "template/vitest.config.mts",
    "CHANGELOG.md",
    "template/scripts"
  ],
  "keywords": [
    "helfy",
    "scaffold",
    "create",
    "starter"
  ],
  "author": "ikrymsaev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikrymsaev/helfy-create"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test test/create.test.js",
    "test:starter": "node scripts/check-starter.js",
    "prepublishOnly": "npm test && npm run test:starter"
  }
}
