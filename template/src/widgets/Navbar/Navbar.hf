import type { NavBar } from "./Navbar";
import { Link } from "@helfy/helfy";

@template<NavBar>() {
  <nav class="sidebar-nav">
    @for (link of this.links; track link.to) {
      <Link
        to={link.to}
        label={link.label}
        class={this.pathname === link.to ? "nav-link nav-link--active" : "nav-link"}
      />
    }
  </nav>
}
