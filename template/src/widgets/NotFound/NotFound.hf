import type { NotFound } from "./NotFound";
import { Link } from "@helfy/helfy";

@template<NotFound>() {
  <section class="not-found">
    <div class="not-found__code gradient-text">404</div>
    <h1>Page not found</h1>
    <p class="muted">Nothing lives at <code>{this.props.pathname ?? ""}</code>.</p>
    <Link to="/" label="Back to the overview" class="btn btn--primary" />
  </section>
}

@styles {
  .not-found { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 96px 0; text-align: center; }
  .not-found__code { font-size: 6rem; font-weight: 800; line-height: 1; letter-spacing: -0.04em; }
  .not-found p { margin: 0 0 12px; }
}
