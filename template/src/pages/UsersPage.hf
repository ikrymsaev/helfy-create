import type { UsersPage } from "./UsersPage";
import { Link } from "@helfy/helfy";
import { PageHeader } from "@shared/ui/PageHeader/PageHeader";
import { UserList, NotesBoard, ActivityFeed } from "@modules/users";

@fragment("user-skeleton") {
  <div class="skeleton user-skeleton"></div>
}

@template<UsersPage>() {
  <div class="page users-page">
    <PageHeader eyebrow="Feature · server data" title="Users">
      <code>UsersApi</code> serves cached queries, mutations and an infinite feed over
      <code>MockUsersBackend</code>. Loading and errors for the list are handled by
      <code>@safe … @wait … @fail</code> on this page.
    </PageHeader>
    @safe {
      <UserList />
    } @wait {
      <div class="users-skeleton">
        <user-skeleton />
        <user-skeleton />
        <user-skeleton />
        <user-skeleton />
      </div>
    } @fail (error, retry) {
      <div class="card" role="alert">
        <p>{error instanceof Error ? error.message : String(error)}</p>
        <button type="button" class="btn" onclick={retry}>Try again</button>
      </div>
    }
    <p class="muted">Try an error: <Link to="/users/42" label="a user that does not exist" />.</p>

    <NotesBoard />
    <ActivityFeed />
  </div>
}

@styles {
  .users-page {
    gap: 40px;
  }
  .users-skeleton {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .user-skeleton {
    height: 92px;
    border-radius: var(--radius-lg);
  }
}
