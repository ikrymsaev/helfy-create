import type { AppRouter } from "./_router";
import { RouterView } from "@helfy/helfy";
import { NotFound } from "@widgets/NotFound/NotFound";

@template<AppRouter>() {
  @safe {
    <RouterView>
      @slot.notFound({ pathname }) {
        <NotFound pathname={pathname} />
      }
    </RouterView>
  } @wait {
    <div class="page"><div class="skeleton" style="height: 120px"></div></div>
  } @fail (error, retry) {
    <section class="page" role="alert">
      <h2>Something went wrong</h2>
      <p class="muted">{error instanceof Error ? error.message : String(error)}</p>
      <div><button type="button" class="btn" onclick={retry}>Try again</button></div>
    </section>
  }
}
