import type { MainLayout } from "./MainLayout";

@template<MainLayout>() {
  <div class="layout">
    <header class="layout__header">
      <div class="container">@slot:header()</div>
    </header>
    <main class="layout__main">
      <div class="container">@slot:content()</div>
    </main>
    <footer class="layout__footer">
      <div class="container">
        @slot:footer() fallback {
          <span>© 2026</span>
        }
      </div>
    </footer>
  </div>
}

@styles {
  .layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .layout__header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 75%, transparent);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(14px);
  }
  .layout__main {
    flex: 1;
  }
  .container {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 24px;
  }
  .layout__footer {
    padding: 24px 0;
    border-top: 1px solid var(--color-border);
  }
}
