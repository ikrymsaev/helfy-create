import type { CounterPage } from "./CounterPage";

@template<CounterPage>() {
  <div class="page">
    <h1>Counter</h1>
    <p>Count: <strong>{this.count}</strong> ({this.parity})</p>
    <button class="btn" onclick={this.increment}>Increment</button>
    <button class="btn" onclick={this.decrement}>Decrement</button>
    @if (this.count >= 10) {
      <p>That's a lot of clicks!</p>
    }
  </div>
}
