import type { UserList } from "./UserList";
import { Link } from "@helfy/helfy";

@template<UserList>() {
  <ul class="users">
    @for (user of this.users.data ?? []; track user.id) {
      <li>
        <Link to={"/users/" + user.id} class="user card">
          <span class="avatar">{this.initials(user.name)}</span>
          <span class="user__text">
            <span class="user__name">{user.name}</span>
            <span class="user__role">{user.role}</span>
          </span>
        </Link>
      </li>
    }
  </ul>
}

@styles {
  .users {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px;
    margin: 0; padding: 0; list-style: none;
  }
  .user { display: flex; align-items: center; gap: 14px; color: var(--color-text); transition: border-color 0.2s, transform 0.2s; }
  .user:hover { text-decoration: none; border-color: var(--brand-cyan); transform: translateY(-2px); }
  .avatar {
    @add brand-badge from "../../../shared/styles/brand.hf";
    width: 48px; height: 48px;
  }
  .user__text { display: flex; flex-direction: column; }
  .user__name { font-weight: 600; }
  .user__role { font-size: 0.85rem; color: var(--color-text-muted); }
}
