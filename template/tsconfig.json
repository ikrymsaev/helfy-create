{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "target": "es6",
    "baseUrl": "src",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "paths": {
      "@context/*": ["./context/*"],
      "@modules/*": ["./modules/*"],
      "@assets/*": ["./assets/*"],
      "@pages/*": ["./pages/*"],
      "@shared/*": ["./shared/*"],
      "@widgets/*": ["./widgets/*"],
    }
  },
  "include": ["src/**/*", ".helfy/**/*", "declaration.d.ts"]
}
