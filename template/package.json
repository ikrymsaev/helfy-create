{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rspack dev --mode development",
    "build": "rspack build --mode production",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "helfy-doctor --project .",
    "doctor:json": "helfy-doctor --project . --json",
    "typecheck": "tsc --noEmit",
    "mcp:config": "node scripts/mcp-config.mjs"
  },
  "dependencies": {
    "@helfy/helfy": "^0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@helfy/helfy-lint": "^0.3.0",
    "@rspack/cli": "^2.3.0",
    "@rspack/core": "^2.3.0",
    "@rspack/dev-server": "^2.2.2",
    "css-loader": "^7.1.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "@types/node": "^22.10.0",
    "vitest": "4.1.12",
    "jsdom": "^28.1.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "vitest": "4.1.12"
  }
}
